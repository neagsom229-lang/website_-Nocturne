# Server Port (Optional, default 3000)
PORT=3000
API_PORT=3000

# Application Public URL (Optional)
APP_URL=https://bedroom-pop.onrender.com

# PostgreSQL Database Connection String (Required)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# JWT Secret for Session Management (Required, min 32 characters)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Allowed CORS Origins (Optional, comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Trust Reverse Proxy (Optional, set to '1' on Render/Heroku)
TRUST_PROXY=0

# Admin Token for Cache Stats & Maintenance (Optional)
ADMIN_TOKEN=

# TMDB API Key for Movie Search (Optional/Recommended)
TMDB_API_KEY=

# YouTube API Key for Video Search (Optional/Recommended)
YOUTUBE_API_KEY=

# Supabase URL (Optional/Required for Auth)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (Optional/Required for Auth)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (Optional/Required for Auth Admin)
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Supabase URL (Optional/Required for Frontend Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Frontend Supabase Anon Key (Optional/Required for Frontend Auth)
VITE_SUPABASE_ANON_KEY=

# Resend API Key for Transactional Emails (Optional)
RESEND_API_KEY=

# Sender Email Address for Emails (Optional)
EMAIL_FROM=

# Node Environment (Optional, 'production' or 'development')
NODE_ENV=development
