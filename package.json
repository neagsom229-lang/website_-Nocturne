{
  "name": "bedroom-pop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BEDROOM POP — a Design Studio theme demo pack: lo-fi music app, podcast app, music journal, dating app and landing page in one React project.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node backend/server.js",
    "start": "node backend/server.js",
    "backfill:movie-genres": "node backend/scripts/backfill-movie-genres.js",
    "build": "tsc --noEmit && vite build",
    "diagnose:discover": "node backend/scripts/diagnose-discover.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test && vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-player": "^2.16.1",
    "react-router-dom": "^7.6.0",
    "resend": "^6.32.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
